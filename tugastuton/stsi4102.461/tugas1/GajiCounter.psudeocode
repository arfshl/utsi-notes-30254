START
    WHILE TRUE 
    PRINT "MASUKKAN GOLONGAN KARYAWAN (A/B/C)" = GOLONGAN
    READ GOLONGAN
        CASE GOLONGAN IN
            A|a: GOLONGAN=5000000
            B|b: GOLONGAN=6500000
            C|c: GOLONGAN=9500000
            *: PRINT "GOLONGAN KARYAWAN TIDAK VALID! (A/B/C)"
        ENDCASE
    END

    WHILE TRUE
    PRINT "MASUKKAN JAM LEMBUR" = JAMLEMBUR
    READ JAMLEMBUR
        CASE JAMLEMBUR IN
            1: JAMLEMBUR=30
            2: JAMLEMBUR=32
            3: JAMLEMBUR=34
            4: JAMLEMBUR=36
            ≥5: JAMLEMBUR=38
            *: PRINT "JAM LEMBUR TIDAK VALID!"
        ENDCASE
    END

    PRINT "MENGHITUNG TOTAL GAJI"
    GAJILEMBUR = GOLONGAN * (JAMLEMBUR / 100)
    TOTALGAJI = GAJILEMBUR + GOLONGAN

    PRINT "RINCIAN TOTAL GAJI KARYAWAN:"
    PRINT "GAJI LEMBUR ANDA BULAN INI:"
    PRINT GAJILEMBUR
    PRINT "TOTAL GAJI ANDA BULAN INI"
    PRINT TOTALGAJI

END
